{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/sessions/:action",
      "destination": "/api/sessions?action=:action"
    },
    {
      "source": "/api/workspace/:service",
      "destination": "/api/workspace?service=:service"
    },
    {
      "source": "/favicon.ico",
      "destination": "/public/favicon.ico"
    },
    {
      "source": "/favicon.png",
      "destination": "/public/favicon.png"
    },
    {
      "source": "/favicon-16x16.png",
      "destination": "/public/favicon-16x16.png"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/public/favicon-32x32.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/public/apple-touch-icon.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/public/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/public/icon-512.png"
    },
    {
      "source": "/icon-maskable-512.png",
      "destination": "/public/icon-maskable-512.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/public/sw.js"
    },
    {
      "source": "/onboarding-tour.js",
      "destination": "/public/onboarding-tour.js"
    },
    {
      "source": "/study-notebook-games.js",
      "destination": "/public/study-notebook-games.js"
    },
    {
      "source": "/cookie-consent.js",
      "destination": "/public/cookie-consent.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    }
  ]
}
