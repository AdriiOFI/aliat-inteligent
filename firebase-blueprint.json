{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and secure user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Google Profile picture URL" },
        "phoneNumber": { "type": "string", "description": "Verified phone number" },
        "phoneVerified": { "type": "boolean", "description": "Phone verification status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User custom preferences and AI provider configs",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "aiProvider": { "type": "string" },
        "aiModel": { "type": "string" },
        "aiKey": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "/users/{userId}/settings/preferences": {
      "schema": "UserSettings",
      "description": "User preferences subcollection"
    }
  }
}
